# Copy this file to application-secret.properties and update with your credentials

# Database credentials
DB_USERNAME=root
DB_PASSWORD=123456
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/clinicbookingdb

# JWT secret (min 256 bits)
JWT_SECRET=SuperSecretKeyClinicBooking123456789

# OAuth2 (Dummy values allow server to start if not using Google/Facebook login)
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
FACEBOOK_CLIENT_ID=dummy-facebook-client-id
FACEBOOK_CLIENT_SECRET=dummy-facebook-client-secret

# Mail configuration
MAIL_USERNAME=dummy@gmail.com
MAIL_PASSWORD=dummypassword

# Optional: Gemini API key for AI Chatbot
# GEMINI_API_KEY=your_gemini_api_key
